# Copy to config.env (git ignored) and fill in. Then run ./bootstrap.sh from Cloud Shell.

# Billing account ID, format XXXXXX-XXXXXX-XXXXXX (Console: Billing > Account management)
BILLING_ACCOUNT_ID=

# Optional. Leave empty if your Google Cloud has no organization (plain Google account sign up).
ORG_ID=

# Project ID parts. Project IDs are global, so a short random suffix avoids collisions.
PROJECT_PREFIX=sm-pilot
PROJECT_SUFFIX=

# GitHub owner (organization or user) and repository, exactly as GitHub shows them (case matters).
GITHUB_OWNER=
GITHUB_REPO=mini-philia

REGION=us-central1

# Monthly budget in USD for the whole billing account.
BUDGET_USD=100

# Optional. Studio Build > Settings shows this "Budget push URL". When set, budget messages are also
# pushed to Studio, signed with a Google OIDC token from the budget-push service account.
STUDIO_BUDGET_PUSH_URL=
